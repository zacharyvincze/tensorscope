{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "prerelease": true,
  "bootstrap-sha": "9054caed113409b39ab50cd64540f05ec2bb3d31",
  "packages": {
    ".": {
      "extra-files": [
        "CMakeLists.txt",
        "Doxyfile",
        "README.md",
        "docs/capture-library.md",
        { "type": "json", "path": "extension/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "extension/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "extension/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
